rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to all files
      allow read: if true;
      
      // Allow write access only to authenticated admins
      allow write: if request.auth != null && (
        request.auth.token.email == "guptakundan1984k@gmail.com" ||
        request.auth.token.email == "anshgupta4525@gmail.com" ||
        request.auth.token.email == "kalikastore.info@gmail.com" ||
        request.auth.token.email == "customercare@kalikastore.in" ||
        request.auth.uid == "yaOovg7opUSgrQbsJ6abztHuOV03" ||
        request.auth.uid == "u0wqoiZcqsVrIbCjwI2osKeRLZo1"
      );
    }
  }
}
