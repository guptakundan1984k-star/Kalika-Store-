rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Identity Integrity: Verification of verified email (optional but recommended)
    function isVerified() {
      return isAuthenticated() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'phone');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          "guptakundan1984k@gmail.com",
          "kalikastore.info@gmail.com",
          "anshgupta4525@gmail.com"
        ] ||
        request.auth.token.phone_number in [
          "+919608123427",
          "+916205284423",
          "+919905516803"
        ] ||
        request.auth.uid in [
          "u0wqoiZcqsVrIbCjwI2osKeRLZo1",
          "yaOovg7opUSgrQbsJ6abztHuOV03"
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaff() {
      return isAdmin() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cs');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasOnlyAllowedFields(fields) {
      return incoming().keys().hasOnly(fields);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_#-]+$');
    }

    // ===============================================================
    // Domain Validators (The Blueprints)
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'name', 'email', 'phone', 'role', 'password', 'address', 'addresses', 'wishlist', 'lastActiveAt', 'updatedAt', 'customPrices', 'walletBalance', 'introSeen', 'upiId', 'upiName', 'adViewsCount', 'totalAdEarnings', 'pendingBonus']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('email' in data) || (data.email is string)) &&
             (!('phone' in data) || (data.phone is string)) &&
             data.role in ['user', 'admin', 'cs'] &&
             (!('password' in data) || (data.password is string)) &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is number)) &&
             (!('updatedAt' in data) || (data.updatedAt is number)) &&
             (!('customPrices' in data) || (data.customPrices is map)) &&
             (!('walletBalance' in data) || (data.walletBalance is number)) &&
             (!('introSeen' in data) || (data.introSeen is bool)) &&
             (!('wishlist' in data) || (data.wishlist is list)) &&
             (!('upiId' in data) || (data.upiId is string)) &&
             (!('upiName' in data) || (data.upiName is string)) &&
             (!('adViewsCount' in data) || (data.adViewsCount is number)) &&
             (!('totalAdEarnings' in data) || (data.totalAdEarnings is number)) &&
             (!('pendingBonus' in data) || (data.pendingBonus is map));
    }

    function isValidProduct(data) {
      return hasOnlyAllowedFields(['id', 'name', 'description', 'price', 'originalPrice', 'purchasePrice', 'category', 'image', 'stock', 'createdAt', 'rating', 'reviewCount', 'weight', 'unit', 'tag', 'variations', 'barcode']) &&
             data.name is string && data.name.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.image is string &&
             data.stock is number &&
             data.createdAt is number &&
             (!('rating' in data) || (data.rating is number)) &&
             (!('reviewCount' in data) || (data.reviewCount is number)) &&
             (!('weight' in data) || (data.weight is string)) &&
             (!('unit' in data) || (data.unit is string)) &&
             (!('tag' in data) || (data.tag is string)) &&
             (!('variations' in data) || (data.variations is map)) &&
             (!('barcode' in data) || (data.barcode is string));
    }

    function isValidOrder(data) {
      return hasOnlyAllowedFields(['id', 'userId', 'userName', 'userPhone', 'items', 'total', 'status', 'deliveryType', 'address', 'pin', 'createdAt', 'updatedAt', 'tracking', 'deliverySlot', 'paymentMethod', 'prescriptionImage', 'earnedPoints', 'redeemedPoints', 'inBag', 'cancellationReason', 'cancelledBy', 'deliveredBy', 'receivedAmount', 'isPreOrder', 'discount', 'walletAdjusted', 'walletRedeemed', 'walletDebtSettle', 'estimatedDelivery', 'subtotal', 'deliveryFee', 'walletUsed', 'orderType', 'timestamp', 'placedBy', 'adminName', 'adminPhone', 'discountCode']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.status is string &&
             data.total is number && data.total >= 0 &&
             data.deliveryType in ['Takeaway', 'Delivery'] &&
             data.pin is string && data.pin.size() >= 4 &&
             data.createdAt is number &&
             data.items is list &&
             (!('address' in data) || (data.address == null || data.address is map)) &&
             (!('tracking' in data) || (data.tracking is list)) &&
             (!('deliverySlot' in data) || (data.deliverySlot == null || data.deliverySlot is string)) &&
             (!('paymentMethod' in data) || (data.paymentMethod == null || data.paymentMethod is string)) &&
             (!('earnedPoints' in data) || (data.earnedPoints is number)) &&
             (!('redeemedPoints' in data) || (data.redeemedPoints is number)) &&
             (!('inBag' in data) || (data.inBag is bool)) &&
             (!('updatedAt' in data) || (data.updatedAt is number)) &&
             (!('deliveredBy' in data) || (data.deliveredBy is string)) &&
             (!('receivedAmount' in data) || (data.receivedAmount is number)) &&
             (!('cancellationReason' in data) || (data.cancellationReason is string)) &&
             (!('cancelledBy' in data) || (data.cancelledBy is string)) &&
             (!('isPreOrder' in data) || (data.isPreOrder is bool)) &&
             (!('discount' in data) || (data.discount is number)) &&
             (!('walletAdjusted' in data) || (data.walletAdjusted is bool)) &&
             (!('walletRedeemed' in data) || (data.walletRedeemed is number)) &&
             (!('walletDebtSettle' in data) || (data.walletDebtSettle is number)) &&
             (!('estimatedDelivery' in data) || (data.estimatedDelivery is number)) &&
             (!('subtotal' in data) || (data.subtotal is number)) &&
             (!('deliveryFee' in data) || (data.deliveryFee is number)) &&
             (!('walletUsed' in data) || (data.walletUsed is number)) &&
             (!('timestamp' in data) || (data.timestamp is string)) &&
             (!('placedBy' in data) || (data.placedBy is string)) &&
             (!('adminName' in data) || (data.adminName is string)) &&
             (!('adminPhone' in data) || (data.adminPhone is string)) &&
             (!('orderType' in data) || (data.orderType in ['personal', 'sell']));
    }

    function isValidReview(data) {
      return hasOnlyAllowedFields(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'photos', 'createdAt', 'isCSReview', 'orderId', 'status']) &&
             data.productId is string && data.userId is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() < 2000 &&
             (!('photos' in data) || data.photos is list) &&
             (!('isCSReview' in data) || data.isCSReview is bool) &&
             (!('orderId' in data) || data.orderId is string) &&
             (!('status' in data) || data.status in ['pending', 'approved', 'rejected']) &&
             data.createdAt is number;
    }

    function isValidBanner(data) {
      return hasOnlyAllowedFields(['id', 'image', 'title', 'link', 'active', 'createdAt']) &&
             data.image is string && data.image.size() > 0 &&
             data.title is string && data.title.size() > 0 &&
             data.active is bool;
    }

    function isValidCoupon(data) {
      return hasOnlyAllowedFields(['id', 'code', 'discount', 'type', 'minOrder', 'maxDiscount', 'expiryDate', 'usageLimitPerCustomer', 'createdAt']) &&
             data.code is string && data.code.size() > 0 &&
             data.discount is number && data.discount >= 0 &&
             data.type in ['percentage', 'fixed'];
    }

    function isValidSupportQuery(data) {
      return hasOnlyAllowedFields(['userId', 'userName', 'userEmail', 'userPhone', 'chatHistory', 'status', 'updatedAt', 'createdAt']) &&
             data.userId is string &&
             data.status in ['pending', 'resolved'] &&
             (!('chatHistory' in data) || data.chatHistory is list);
    }

    function isValidBulkEnquiry(data) {
      return hasOnlyAllowedFields(['userId', 'name', 'email', 'phone', 'storeName', 'message', 'status', 'createdAt']) &&
             data.userId is string &&
             data.storeName is string && data.storeName.size() > 0 &&
             data.status in ['Pending', 'Contacted', 'Closed'] &&
             data.createdAt is number;
    }

    function isValidFeatureRequest(data) {
      return hasOnlyAllowedFields(['userId', 'userName', 'feature', 'status', 'createdAt']) &&
             data.userId is string &&
             data.feature is string && data.feature.size() > 0 &&
             data.status in ['pending', 'reviewed', 'implemented'] &&
             data.createdAt is number;
    }

    function isValidDue(data) {
      return hasOnlyAllowedFields(['id', 'name', 'phone', 'address', 'amount', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() > 0 &&
             data.address is string && data.address.size() > 0 &&
             data.amount is number &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidWalletTransaction(data) {
      return hasOnlyAllowedFields(['id', 'userId', 'amount', 'balanceAfter', 'type', 'description', 'orderId', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.amount is number &&
             data.balanceAfter is number &&
             data.type in ['order_payment', 'add_money', 'delivery_adjustment', 'manual_correction', 'wallet_topup', 'manual_debit'] &&
             data.description is string &&
             data.createdAt is number;
    }

    function isValidWalletRequest(data) {
      return hasOnlyAllowedFields(['id', 'userId', 'userName', 'userPhone', 'amount', 'status', 'createdAt', 'method', 'screenshot']) &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 &&
             data.userPhone is string &&
             data.amount is number && data.amount > 0 &&
             data.status == 'pending' &&
             (!('method' in data) || (data.method == null || data.method is string)) &&
             (!('screenshot' in data) || (data.screenshot == null || data.screenshot is string)) &&
             data.createdAt is number;
    }

    function isValidExpense(data) {
      return hasOnlyAllowedFields(['itemName', 'amount', 'date', 'source', 'category', 'photoUrl', 'quantity']) &&
             data.itemName is string && data.itemName.size() > 0 &&
             data.amount is number && data.amount >= 0 &&
             data.date is number;
    }
    
    function isValidNotification(data) {
      return hasOnlyAllowedFields(['userId', 'title', 'body', 'type', 'orderId', 'createdAt', 'isRead']) &&
             data.userId is string &&
             data.title is string && data.title.size() > 0 &&
             data.body is string && data.body.size() > 0 &&
             data.type in ['order', 'promotion', 'system', 'wallet'] &&
             (!('orderId' in data) || data.orderId is string) &&
             data.createdAt is number &&
             data.isRead is bool;
    }

    function isValidStoreSettings(data) {
      return hasOnlyAllowedFields(['isOpen', 'autoSchedule', 'isFunctionallyOpen', 'openingTime', 'closingTime', 'sundayOpeningTime', 'sundayClosingTime', 'message', 'storeName', 'contactPhone', 'contactEmail', 'storeAddress', 'logoUrl', 'deliveryFee', 'freeDeliveryThreshold', 'isVoiceSupportEnabled', 'isAiAssistantEnabled', 'isDeliveryEnabled', 'updatedAt']) &&
             data.isOpen is bool &&
             data.autoSchedule is bool &&
             data.openingTime is string &&
             data.closingTime is string &&
             (!('isVoiceSupportEnabled' in data) || (data.isVoiceSupportEnabled is bool)) &&
             (!('isAiAssistantEnabled' in data) || (data.isAiAssistantEnabled is bool)) &&
             (!('isDeliveryEnabled' in data) || (data.isDeliveryEnabled is bool)) &&
             data.updatedAt is number;
    }

    // ===============================================================
    // Resource Rules
    // ===============================================================

    function isValidAdEarning(data) {
      return hasOnlyAllowedFields(['id', 'userId', 'userName', 'count', 'lastWatchedAt', 'paymentStatus', 'upiId', 'upiName', 'paidAt', 'transactionId', 'createdAt']) &&
             data.userId is string &&
             data.count is number &&
             data.paymentStatus in ['pending', 'paid'];
    }

    match /settings/store {
      allow read: if true;
      allow write: if isAdmin() && isValidStoreSettings(incoming());
    }

    match /settings/google_drive {
      allow read, write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && isValidUser(incoming()) && (isOwner(userId) || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming());
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    match /orders/{orderId} {
      allow read: if (isAuthenticated() && (existing().userId == request.auth.uid || isStaff()));
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() && isValidOrder(incoming()) && (incoming().userId == request.auth.uid || isStaff());
      allow update: if (isStaff() && isValidOrder(incoming())) || 
                    (isOwner(existing().userId) && 
                     incoming().status == 'Cancelled' && 
                     existing().status in ['Pending', 'Order Received'] && 
                     isValidOrder(incoming()));
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() && isValidCoupon(incoming());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    isValidReview(incoming()) && 
                    incoming().userId == request.auth.uid && (
                      // Ensure the user actually purchased the product and it was delivered
                      exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
                      get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid &&
                      get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.status == 'Delivered'
                    );
      allow update, delete: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidBanner(incoming());
    }

    match /support_queries/{queryId} {
      allow read: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid && isValidSupportQuery(incoming());
      allow update: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid && isValidSupportQuery(incoming()));
    }

    match /product_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /bulk_enquiries/{enquiryId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidBulkEnquiry(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /feature_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidFeatureRequest(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /dues/{dueId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidDue(incoming());
    }

    match /walletTransactions/{txId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isAuthenticated() && 
        incoming().userId == request.auth.uid && 
        incoming().type == 'order_payment' && 
        incoming().amount <= 0 &&
        isValidWalletTransaction(incoming())
      );
      allow update, delete: if false;
    }

    match /walletRequests/{requestId} {
      allow read: if isAuthenticated() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidWalletRequest(incoming());
      allow update: if (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) || 
                    (isAuthenticated() && resource.data.userId == request.auth.uid && (
                      incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'userName', 'userPhone', 'status']) &&
                      (incoming().status == 'rejected' || !('status' in incoming()))
                    ));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && existing().status == 'pending');
    }

    function isValidDeliveryRequest(data) {
      return hasOnlyAllowedFields(['userId', 'userName', 'userPhone', 'location', 'coordinates', 'mapsUrl', 'type', 'createdAt']) &&
             data.userId is string &&
             data.userName is string &&
             data.userPhone is string &&
             data.location is string &&
             (!('coordinates' in data) || data.coordinates is string) &&
             data.mapsUrl is string &&
             data.type is string &&
             data.createdAt is number;
    }

    match /adEarnings/{earningId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidAdEarning(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && isValidAdEarning(incoming()));
      allow delete: if isAdmin();
    }

    match /delivery_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isValidDeliveryRequest(incoming());
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'admin' && isStaff());
      allow create: if isAuthenticated() && isValidNotification(incoming());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }
  }
}
