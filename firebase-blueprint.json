{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "Product reviews and ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" }
      },
      "required": ["productId", "userId", "rating", "comment"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth ID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role" },
        "address": { "type": "string", "description": "Default address" },
        "addresses": { "type": "array", "items": { "type": "object" } },
        "wishlist": { "type": "array", "items": { "type": "string" } },
        "lastActiveAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "walletBalance": { "type": "number", "description": "User wallet balance (can be negative for dues)" },
        "upiId": { "type": "string" },
        "upiName": { "type": "string" },
        "adViewsCount": { "type": "number" },
        "totalAdEarnings": { "type": "number" },
        "introSeen": { "type": "boolean", "description": "Whether the user has seen the intro tour" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "AdEarnings": {
      "title": "Ad Earnings",
      "description": "Tracking ad views and payouts for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "count": { "type": "number" },
        "lastWatchedAt": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "upiId": { "type": "string" },
        "upiName": { "type": "string" },
        "paidAt": { "type": "number" },
        "transactionId": { "type": "string" }
      },
      "required": ["userId", "count", "paymentStatus"]
    },
    "Due": {
      "title": "Due",
      "description": "Manual due entries for customers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "phone", "address", "amount", "createdAt", "updatedAt"]
    },
    "WalletTransaction": {
      "title": "Wallet Transaction",
      "description": "History of user wallet changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "type": { "type": "string", "enum": ["order_payment", "add_money", "delivery_adjustment", "manual_correction", "wallet_topup"] },
        "description": { "type": "string" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "amount", "balanceAfter", "type", "description", "createdAt"]
    },
    "WalletRequest": {
      "title": "Wallet Request",
      "description": "User requests to add money to wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["online", "offline"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userName", "userPhone", "amount", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Store items for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "stock": { "type": "number" },
        "createdAt": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "weight": { "type": "string" },
        "unit": { "type": "string" },
        "tag": { "type": "string" },
        "variations": { "type": "object" }
      },
      "required": ["name", "price", "category", "stock", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Order Received", "Packed", "Out for Delivery", "Delivered", "Cancelled"] },
        "deliveryType": { "type": "string", "enum": ["Takeaway", "Delivery"] },
        "address": { "type": "object" },
        "pin": { "type": "string" },
        "deliverySlot": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "inBag": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "deliveredBy": { "type": "string" },
        "receivedAmount": { "type": "number" },
        "prescriptionImage": { "type": "string" },
        "tracking": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["userId", "total", "status", "deliveryType", "pin", "createdAt", "items"]
    },
    "FeatureRequest": {
      "title": "Feature Request",
      "description": "User requested app features",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "feature": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "implemented"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userName", "feature", "status", "createdAt"]
    },
    "BulkEnquiry": {
      "title": "Bulk Enquiry",
      "description": "B2B and bulk purchase inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeName": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Contacted", "Closed"] },
        "createdAt": { "type": "number" }
      },
      "required": ["storeName", "name", "phone", "email", "message", "status", "createdAt"]
    },
    "SupportQuery": {
      "title": "Support Query",
      "description": "Customer support conversations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "chatHistory": { "type": "array", "items": { "type": "object" } },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userName", "chatHistory", "status", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discount": { "type": "number" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "minOrder": { "type": "number" },
        "expiryDate": { "type": "number" },
        "usageLimitPerCustomer": { "type": "number" }
      },
      "required": ["code", "discount", "type"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Home page promotional banners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["image", "title", "active"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Store operational expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "source": { "type": "string" },
        "category": { "type": "string" },
        "photoUrl": { "type": "string" },
        "quantity": { "type": "string" }
      },
      "required": ["itemName", "amount", "date"]
    },
    "StoreSettings": {
      "title": "Store Settings",
      "description": "Global store configuration",
      "type": "object",
      "properties": {
        "isOpen": { "type": "boolean" },
        "autoSchedule": { "type": "boolean" },
        "openingTime": { "type": "string" },
        "closingTime": { "type": "string" },
        "sundayOpeningTime": { "type": "string" },
        "sundayClosingTime": { "type": "string" },
        "message": { "type": "string" },
        "storeName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "storeAddress": { "type": "string" },
        "logoUrl": { "type": "string" },
        "deliveryFee": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["isOpen", "openingTime", "closingTime"]
    },
    "GoogleDriveSettings": {
      "title": "Google Drive Settings",
      "description": "Google Drive OAuth tokens and status",
      "type": "object",
      "properties": {
        "tokens": { "type": "object" },
        "email": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["tokens", "email"]
    }
  },
  "firestore": {
    "/feature_requests/{requestId}": {
      "schema": "FeatureRequest",
      "description": "User feature requests"
    },
    "/bulk_enquiries/{enquiryId}": {
      "schema": "BulkEnquiry",
      "description": "Business enquiries"
    },
    "/support_queries/{queryId}": {
      "schema": "SupportQuery",
      "description": "Support chat history"
    },
    "/settings/store": {
      "schema": "StoreSettings",
      "description": "Global store operating settings"
    },
    "/settings/google_drive": {
      "schema": "GoogleDriveSettings",
      "description": "Google Drive integration tokens"
    },
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User data collection"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional codes"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Promotional banners"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operational expenses tracking"
    },
    "/dues/{dueId}": {
      "schema": "Due",
      "description": "Customer manual dues"
    },
    "/walletTransactions/{txId}": {
      "schema": "WalletTransaction",
      "description": "User wallet history"
    },
    "/walletRequests/{requestId}": {
      "schema": "WalletRequest",
      "description": "User requests for wallet topup"
    },
    "/adEarnings/{earningId}": {
      "schema": "AdEarnings",
      "description": "Tracking user ad views and payouts"
    }
  }
}
